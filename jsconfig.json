{
  // ==================== 编译器选项 ====================
  "compilerOptions": {
    // 编译目标：ES5（确保代码在大多数现代浏览器中运行）
    "target": "es5",
    // 模块系统：使用最新的 ES 模块标准
    "module": "esnext",
    // 基础路径：模块解析的根目录，设置为项目根目录
    "baseUrl": "./",
    // 模块解析策略：使用 Node.js 的模块解析方式
    "moduleResolution": "node",
    // 路径映射：设置模块导入的别名，简化导入路径
    "paths": {
      // @ 符号映射到 src 目录，常用于导入组件
      "@/*": [
        "src/*"
      ],
      // ~ 符号也映射到 src 目录，常用于导入资源文件
      "~/*": [
        "src/*"
      ]
    },
    // 包含的类型库：指定可用的 API 和内置对象
    "lib": [
      // 最新的 ECMAScript 特性
      "esnext",
      // DOM API（浏览器环境）
      "dom",
      // 可迭代的 DOM API
      "dom.iterable",
      // 脚本宿主 API（如 Windows Script Host）
      "scripthost"
    ]
  },
  // ==================== 包含的文件 ====================
  // 指定需要进行类型检查和智能提示的文件模式
  "include": [
    // JavaScript 文件
    "src/**/*.js",
    // Vue 单文件组件
    "src/**/*.vue",
    // JSON 配置文件
    "src/**/*.json",
    // TypeScript 文件（为将来可能的 TypeScript 支持做准备）
    "src/**/*.ts",
    // TypeScript JSX 文件
    "src/**/*.tsx"
  ],
  // ==================== 排除的文件和目录 ====================
  // 指定不需要进行类型检查的文件和目录
  "exclude": [
    // 依赖包目录
    "node_modules",
    // 构建输出目录
    "dist",
    // 构建相关目录
    "build"
  ]
}
